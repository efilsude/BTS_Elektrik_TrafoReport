# TrafoReport Backend Environment Variables Example
# SECRET_KEY: JWT imzalama anahtarı. Buraya asla sabit/paylaşılan bir değer
# koyma — her ortam kendi rastgele değerini üretmeli. Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_your_own_with_python_-c_"import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///./traforeport.db

# SMTP Email Configuration
EMAIL_ENABLED=false # Yerel/LAN test için false (console sink + debug_code); gerçek SMTP için true
SMTP_HOST=smtp.gmail.com

SMTP_PORT=587
SMTP_USER=noreply@btselektrik.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=TrafoReport <noreply@btselektrik.com>
SMTP_USE_TLS=true

# Optional comma-separated list of admin email addresses for notifications
# If left empty, notifications will be sent to all active users with role='admin' in DB
ADMIN_NOTIFY_EMAILS=admin@btselektrik.com,yonetim@btselektrik.com

VERIFICATION_CODE_TTL_MINUTES=10
